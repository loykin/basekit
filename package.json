{
  "name": "basekit",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "type-check": "pnpm -r --if-present type-check",
    "lint": "eslint packages playground/src scripts --ext .ts,.tsx,.mjs",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:consumer": "node scripts/verify-package-consumer.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:check": "pnpm lint && pnpm test && pnpm build && pnpm test:consumer",
    "release": "changeset publish"
  },
  "packageManager": "pnpm@11.5.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^26.1.0",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3.2.4"
  }
}
